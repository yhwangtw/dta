# DTA identity and local persistence
AGENT_DEFAULT_TYPE=meeting
DTA_DEFAULT_AGENT_ID=meeting-agent
DTA_ENABLED_AGENTS=meeting-agent,pm-agent
# Mount a JSON manifest to add department Agents without rebuilding the image.
DTA_AGENT_MANIFEST_PATH=
DTA_AGENT_WORKSPACE=/app/workspace
DTA_PUBLIC_BASE_URL=http://localhost:30141
DTA_PROVIDER_ORGANIZATION=Digital Transformation Department
DTA_PROVIDER_URL=http://localhost:30141

# Authentication: none for local development; keycloak in company environments.
DTA_AUTH_MODE=none
# Set to x-forwarded-access-token when an authenticated proxy injects the token.
DTA_AUTH_TOKEN_HEADER=authorization
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=
KEYCLOAK_JWKS_URL=
KEYCLOAK_REQUIRED_ROLES=
DTA_REVIEW_REQUIRED_ROLES=dta-reviewer
DTA_MEETING_REVIEW_REQUIRED=true

# Optional company LLM gateway for server-side Agent Contract and A2A runs.
# Leave LLM_BASE_URL and LLM_MODEL empty to keep using Pi's local model settings.
LLM_PROVIDER_ID=dta-company
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_API=openai-responses
LLM_AUTH_HEADER=true
LLM_SUPPORTS_IMAGES=false
LLM_CONTEXT_WINDOW=128000
LLM_MAX_TOKENS=16384

# Workflow adapter. Keep tools disabled until the side-effect policy is approved.
DTA_WORKFLOW_PROVIDER=mock
DTA_ENABLE_WORKFLOW_TOOLS=false
N8N_BASE_URL=
N8N_EDITOR_URL=
N8N_API_KEY=
N8N_AUTH_HEADER=Authorization
N8N_AUTH_SCHEME=Bearer
N8N_TIMEOUT_MS=30000
N8N_WORKFLOW_MAP_JSON={"meeting-create-jira":"/webhook/meeting-create-jira","meeting-notify-teams":"/webhook/meeting-notify-teams","meeting-update-knowledge-base":"/webhook/meeting-update-knowledge-base","pm-create-jira-epic":"/webhook/pm-create-jira-epic","pm-publish-prd":"/webhook/pm-publish-prd","pm-notify-team":"/webhook/pm-notify-team"}

# Artifact storage. Switch to minio inside the company without rebuilding the image.
DTA_ARTIFACT_STORE=local
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_REGION=us-east-1
MINIO_PREFIX=dta
DTA_DATA_DIR=

# Conversation memory. Local works outside the company; Postgres or Redis can
# be selected in Kubernetes without changing the image.
DTA_MEMORY_STORE=local
POSTGRES_URL=
REDIS_URL=
DTA_MEMORY_MAX_ENTRIES=1000
DTA_MEMORY_TTL_SECONDS=7776000

# Governance and operations
DTA_AUDIT_LOG_ENABLED=true
DTA_AUDIT_LOG_PATH=
DTA_METRICS_AUTH_REQUIRED=true
DTA_RATE_LIMIT_ENABLED=false
DTA_RATE_LIMIT_REQUESTS=60
DTA_RATE_LIMIT_WINDOW_SECONDS=60

# Optional HTTP malware scanner. It must return {"status":"clean"} or
# {"status":"infected","threat":"..."}; configured scanners fail closed.
DTA_UPLOAD_SCANNER=none
DTA_UPLOAD_SCANNER_URL=
DTA_UPLOAD_SCANNER_API_KEY=
DTA_UPLOAD_SCANNER_AUTH_HEADER=Authorization
DTA_UPLOAD_SCANNER_AUTH_SCHEME=Bearer
DTA_UPLOAD_SCANNER_TIMEOUT_MS=60000
DTA_UPLOAD_SCANNER_FAIL_OPEN=false

# Automatic deletion is opt-in. For MinIO, configure the matching bucket
# lifecycle policy because DTA intentionally does not enumerate the bucket.
DTA_RETENTION_ENABLED=false
DTA_ARTIFACT_RETENTION_DAYS=365
DTA_RETENTION_PROTECT_APPROVED=true

# Meeting media understanding. Mock modes are development/test only.
DTA_TRANSCRIPTION_PROVIDER=none
DTA_MOCK_TRANSCRIPT=
DTA_TRANSCRIPTION_BASE_URL=
DTA_TRANSCRIPTION_API_KEY=
DTA_TRANSCRIPTION_MODEL=
DTA_TRANSCRIPTION_RESPONSE_FORMAT=auto
DTA_TRANSCRIPTION_TIMEOUT_MS=600000

DTA_VISION_PROVIDER=none
DTA_MOCK_VISION_RESULT=
DTA_VISION_BASE_URL=
DTA_VISION_API_KEY=
DTA_VISION_MODEL=
DTA_VISION_TIMEOUT_MS=300000

# FFmpeg is included in the production image. Override paths only when required.
DTA_MEDIA_PROCESSOR=ffmpeg
DTA_FFMPEG_PATH=ffmpeg
DTA_FFPROBE_PATH=ffprobe
DTA_MEDIA_MAX_DURATION_SECONDS=14400
DTA_MEDIA_PROCESS_TIMEOUT_MS=300000
DTA_VIDEO_MAX_KEYFRAMES=12
DTA_VIDEO_FRAME_WIDTH=1280

# Existing Pi Web access gate
PIWEB_ACCESS_PASSWORD=
PIWEB_SESSION_SECRET=
PI_CODING_AGENT_DIR=

# Business-system connections remain behind n8n or future adapters.
JIRA_BASE_URL=
JIRA_API_TOKEN=
