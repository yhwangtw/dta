{
  "version": 2,
  "agents": [
    {
      "id": "knowledge-agent",
      "displayName": "Knowledge Agent",
      "description": "Creates governed knowledge briefs from approved department sources.",
      "systemPrompt": "Create source-backed knowledge briefs. Preserve citations, distinguish facts from assumptions, and ask for approval before recommending publication.",
      "enabledByDefault": false,
      "workflowAllowlist": [
        "knowledge-publish"
      ],
      "inputSchema": {
        "type": "object",
        "required": [
          "topic"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "sourceArtifactIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "brief",
          "sources"
        ],
        "properties": {
          "brief": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "artifactTypes": [
        "KNOWLEDGE_BRIEF"
      ],
      "reviewPolicy": "required",
      "allowedRoles": [
        "dta-knowledge"
      ],
      "modelPolicy": {
        "allowedProviders": [
          "dta-company"
        ],
        "allowedModels": [
          "company-model"
        ],
        "maxOutputTokens": 4096,
        "timeoutSeconds": 300
      },
      "evaluationFixtures": [
        {
          "name": "baseline source-backed brief",
          "input": {
            "topic": "pilot readiness",
            "sourceArtifactIds": [
              "example-artifact-id"
            ]
          },
          "expectedPaths": [
            "brief",
            "sources"
          ]
        }
      ],
      "skills": [
        {
          "id": "knowledge-brief",
          "name": "Knowledge brief",
          "description": "Turn approved source material into a traceable knowledge brief.",
          "tags": [
            "knowledge",
            "brief",
            "governance"
          ],
          "inputModes": [
            "text/plain",
            "application/json"
          ],
          "outputModes": [
            "text/markdown",
            "application/json"
          ]
        }
      ]
    }
  ]
}
