{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "service", "config", "secret"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "enum": [1],
      "description": "DTA runtime state is process-local and currently supports exactly one replica."
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port", "targetPort"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": { "type": "array", "minItems": 1 }
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "required": ["env"],
      "properties": {
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "agentManifest": { "type": "string", "minLength": 1 },
    "secret": {
      "type": "object",
      "required": ["create", "existingSecret", "env"],
      "properties": {
        "create": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "values": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "key", "optional"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
              "key": { "type": "string", "minLength": 1 },
              "optional": { "type": "boolean" }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "data": { "$ref": "#/definitions/persistence" },
        "workspace": { "$ref": "#/definitions/persistence" }
      }
    }
  },
  "definitions": {
    "persistence": {
      "type": "object",
      "required": ["enabled", "existingClaim", "accessModes", "size"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "size": { "type": "string", "minLength": 1 }
      }
    }
  }
}
